<odoo>
    <!-- vendor.bill.claude.code.import.wizard — all internal users may use
         the wizard; the attachment and job it creates go through sudo(). -->
    <record
        id="vendor_bill_claude_code_import_wizard_all_access"
        model="ir.model.access"
    >
        <field name="name">vendor.bill.claude.code.import.wizard - all</field>
        <field name="model_id" ref="model_vendor_bill_claude_code_import_wizard" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
