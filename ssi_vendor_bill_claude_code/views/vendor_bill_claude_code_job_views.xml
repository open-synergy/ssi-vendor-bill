<odoo>
    <record id="vendor_bill_claude_code_job_view_tree" model="ir.ui.view">
        <field name="name">vendor.bill.claude.code.job - tree</field>
        <field name="model">vendor.bill.claude.code.job</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="state == 'failed'"
                decoration-warning="state == 'need_review'"
                decoration-success="state == 'done'"
                decoration-muted="state in ('draft', 'queued')"
            >
                <field name="name" />
                <field name="source_filename" />
                <field name="move_id" />
                <field name="backend_id" />
                <field name="external_status" optional="hide" />
                <field name="state" widget="badge" />
                <field name="create_date" optional="show" />
            </tree>
        </field>
    </record>

    <record id="vendor_bill_claude_code_job_view_form" model="ir.ui.view">
        <field name="name">vendor.bill.claude.code.job - form</field>
        <field name="model">vendor.bill.claude.code.job</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                        attrs="{'invisible': [('state', 'not in', ('failed', 'need_review'))]}"
                    />
                    <button
                        name="action_open_move"
                        type="object"
                        string="Open Vendor Bill"
                        class="btn-secondary"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="source_filename" />
                            <field name="move_id" />
                            <field name="backend_id" />
                        </group>
                        <group>
                            <field name="external_id" />
                            <field name="external_status" />
                        </group>
                    </group>
                    <notebook>
                        <page name="error" string="Error">
                            <field name="error_message" nolabel="1" />
                        </page>
                        <page name="response" string="Raw Response">
                            <field
                                name="response_json"
                                nolabel="1"
                                widget="text"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vendor_bill_claude_code_job_view_search" model="ir.ui.view">
        <field name="name">vendor.bill.claude.code.job - search</field>
        <field name="model">vendor.bill.claude.code.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="source_filename" />
                <field name="move_id" />
                <field name="backend_id" />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
                <filter
                    name="need_review"
                    string="Need Review"
                    domain="[('state', '=', 'need_review')]"
                />
                <filter
                    name="done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="vendor_bill_claude_code_job_action" model="ir.actions.act_window">
        <field name="name">Vendor Bill AI Import Jobs</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vendor.bill.claude.code.job</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_vendor_bill_claude_code_job"
        name="Vendor Bill AI Import Jobs"
        parent="ssi_financial_accounting.menu_account_configuration"
        action="vendor_bill_claude_code_job_action"
    />
</odoo>
