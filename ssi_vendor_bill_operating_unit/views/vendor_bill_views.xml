<odoo>
<record id="vendor_bill_view_tree" model="ir.ui.view">
    <field name="name">vendor_bill tree - operating unit</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="ssi_vendor_bill.vendor_bill_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- vendor_bill_view_search and vendor_bill_view_form used to add
     operating_unit_id / the grp_ou filter here too, but both are already
     inherited from ssi_financial_accounting_operating_unit through the
     primary rebind chain (vendor_bill_view_search/vendor_bill_view_form
     are primary views of account.view_account_invoice_filter /
     account.view_move_form, so they automatically pick up every
     non-primary inherit already applied to those base views). Adding them
     again here duplicated the field/filter on screen, see
     open-synergy/ssi-vendor-bill#13. -->
</odoo>
