<odoo>
<record id="vendor_bill_view_tree" model="ir.ui.view">
    <field name="name">vendor_bill tree - operating unit</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="ssi_vendor_bill.vendor_bill_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- The core `account.view_account_invoice_filter` search view (which
     `vendor_bill_view_search` rebinds) has no `company_id` field or
     company group-by filter to anchor on. Mirrors how
     ssi_financial_accounting_operating_unit's own `account_invoice_view_search`
     handles this same core view: only add the group-by filter. -->
<record id="vendor_bill_view_search" model="ir.ui.view">
    <field name="name">vendor_bill search - operating unit</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="ssi_vendor_bill.vendor_bill_view_search" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//filter[@name='duedate']" position="after">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by': 'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="vendor_bill_view_form" model="ir.ui.view">
    <field name="name">vendor_bill form - operating unit</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="ssi_vendor_bill.vendor_bill_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//div[@class='o_td_label'][1]" position="before">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
