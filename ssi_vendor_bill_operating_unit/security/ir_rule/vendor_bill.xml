<odoo>
<record id="vendor_bill_rule_ou" model="ir.rule">
    <field name="name">vendor_bill - ou</field>
    <field name="model_id" ref="ssi_vendor_bill.model_vendor_bill" />
    <field
            name="groups"
            eval="[(4, ref('ssi_financial_accounting_operating_unit.bill_ou_group'))]"
        />
    <field name="domain_force">
        ['|', ('operating_unit_id','=',False),
        ('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]
    </field>
    <field eval="1" name="perm_unlink" />
    <field eval="1" name="perm_write" />
    <field eval="1" name="perm_read" />
    <field eval="1" name="perm_create" />
</record>
</odoo>
