<odoo noupdate="1">
<record id="sequence_vendor_bill" model="ir.sequence">
    <field name="name">Vendor Bill</field>
    <field name="code">vendor_bill</field>
    <field name="padding">6</field>
    <field name="prefix">BILL/%(range_year)s/</field>
    <field eval="1" name="number_next" />
    <field eval="1" name="number_increment" />
    <field name="use_date_range" eval="1" />
    <field eval="False" name="company_id" />
</record>
</odoo>
