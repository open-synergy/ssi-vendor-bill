    <field name="template_id" ref="policy_template_vendor_bill" />
    <field
            name="field_id"
            search="[('model_id.model','=','vendor_bill'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','vendor_bill'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('vendor_bill_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

