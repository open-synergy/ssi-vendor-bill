<odoo>
<!-- Global rule: this model is, by definition, a vendor bill only.
     Being global (no group), it is ANDed with every other rule and applies to
     all users (admin included) so that other move types (customer invoices,
     refunds, journal entries, ...) stored in the shared account_move table
     are never returned here. -->
<record id="vendor_bill_global_rule" model="ir.rule">
    <field name="name">Vendor Bill - Only In Invoice Move Type</field>
    <field name="model_id" ref="model_vendor_bill" />
    <!-- No `groups`: an ir.rule without groups is a global rule (ANDed with
         every group rule and applied to all non-superuser users). -->
    <field name="domain_force">[('move_type', '=', 'in_invoice')]</field>
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
</record>

<!-- Data ownership rules (reuse ssi_financial_accounting bill groups) -->
<record id="vendor_bill_company_rule" model="ir.rule">
    <field name="name">Vendor Bill - Responsible to company data</field>
    <field name="model_id" ref="model_vendor_bill" />
    <field
            name="groups"
            eval="[(4, ref('ssi_financial_accounting.bill_company_group'))]"
        />
    <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="vendor_bill_companies_rule" model="ir.rule">
    <field
            name="name"
        >Vendor Bill - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_vendor_bill" />
    <field
            name="groups"
            eval="[(4, ref('ssi_financial_accounting.bill_company_child_group'))]"
        />
    <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="vendor_bill_all_rule" model="ir.rule">
    <field name="name">Vendor Bill - All</field>
    <field name="model_id" ref="model_vendor_bill" />
    <field name="groups" eval="[(4, ref('ssi_financial_accounting.bill_all_group'))]" />
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
