<odoo>
<!-- Local workflow category. Labelled "Vendor Bill" (not "Bill") on purpose so
     these groups do not get confused in the UI with the ssi_financial_accounting
     "Bill" groups that share the same parent category. -->
<record id="vendor_bill_workflow_module_category" model="ir.module.category">
    <field name="name">Vendor Bill</field>
    <field
            name="parent_id"
            ref="ssi_financial_accounting.financial_accounting_module_category"
        />
</record>

<record id="vendor_bill_data_ownership_module_category" model="ir.module.category">
    <field name="name">Vendor Bill</field>
    <field
            name="parent_id"
            ref="ssi_financial_accounting.financial_accounting_data_ownership_module_category"
        />
</record>
</odoo>
