<odoo>
<record id="vendor_bill_type_view_search" model="ir.ui.view">
    <field name="name">vendor_bill_type - search</field>
    <field name="model">vendor_bill_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="vendor_bill_type_view_tree" model="ir.ui.view">
    <field name="name">vendor_bill_type - tree</field>
    <field name="model">vendor_bill_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="journal_id" />
                <field name="payable_account_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="vendor_bill_type_view_form" model="ir.ui.view">
    <field name="name">vendor_bill_type - form</field>
    <field name="model">vendor_bill_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="accounting" string="Accounting">
                    <group name="accounting_1" colspan="4" col="2">
                        <field name="journal_id" />
                        <field name="payable_account_id" />
                    </group>
                </page>
                <page name="product_config" string="Product Configuration">
                    <group name="product_config_1" colspan="4" col="2">
                        <field name="product_selection_method" />
                        <field
                                name="product_ids"
                                widget="many2many_tags"
                                attrs="{'invisible':[('product_selection_method','!=','manual')]}"
                            />
                        <field
                                name="product_domain"
                                widget="domain"
                                options="{'model': 'product.product', 'in_dialog': True}"
                                attrs="{'invisible':[('product_selection_method','!=','domain')]}"
                            />
                        <field
                                name="product_python_code"
                                widget="ace"
                                attrs="{'invisible':[('product_selection_method','!=','code')]}"
                            />
                    </group>
                </page>
                <page name="currency_config" string="Currency Configuration">
                    <group name="currency_config_1" colspan="4" col="2">
                        <field name="currency_selection_method" />
                        <field
                                name="currency_ids"
                                widget="many2many_tags"
                                attrs="{'invisible':[('currency_selection_method','!=','manual')]}"
                            />
                        <field
                                name="currency_domain"
                                widget="domain"
                                options="{'model': 'res.currency', 'in_dialog': True}"
                                attrs="{'invisible':[('currency_selection_method','!=','domain')]}"
                            />
                        <field
                                name="currency_python_code"
                                widget="ace"
                                attrs="{'invisible':[('currency_selection_method','!=','code')]}"
                            />
                    </group>
                </page>
                <page name="pricelist_config" string="Pricelist Configuration">
                    <group name="pricelist_config_1" colspan="4" col="2">
                        <field name="pricelist_selection_method" />
                        <field
                                name="pricelist_ids"
                                widget="many2many_tags"
                                attrs="{'invisible':[('pricelist_selection_method','!=','manual')]}"
                            />
                        <field
                                name="pricelist_domain"
                                widget="domain"
                                options="{'model': 'product.pricelist', 'in_dialog': True}"
                                attrs="{'invisible':[('pricelist_selection_method','!=','domain')]}"
                            />
                        <field
                                name="pricelist_python_code"
                                widget="ace"
                                attrs="{'invisible':[('pricelist_selection_method','!=','code')]}"
                            />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="vendor_bill_type_action" model="ir.actions.act_window">
    <field name="name">Vendor Bill Types</field>
    <field name="res_model">vendor_bill_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="vendor_bill_type_menu"
        name="Vendor Bill Types"
        parent="ssi_financial_accounting.menu_financial_accounting_configuration"
        action="vendor_bill_type_action"
        groups="vendor_bill_type_group"
        sequence="50"
    />
</odoo>
