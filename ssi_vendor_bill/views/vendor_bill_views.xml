<odoo>
<!-- Primary tree view rebound to vendor_bill -->
<record id="vendor_bill_view_tree" model="ir.ui.view">
    <field name="name">vendor_bill tree</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="account.view_in_invoice_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<!-- Primary search view rebound to vendor_bill -->
<record id="vendor_bill_view_search" model="ir.ui.view">
    <field name="name">vendor_bill search</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<!-- Primary form view rebound to vendor_bill.
     Core account.view_move_form has no dedicated bill form, it is reused
     for every move_type, distinguished by attrs on move_type. The generic
     `action_post` button appears TWICE in that view (positional [1] "Post"
     for move_type=='entry', [2] "Confirm" for the rest); only [2] is
     relevant here since this model always has move_type == 'in_invoice'. -->
<record id="vendor_bill_view_form" model="ir.ui.view">
    <field name="name">vendor_bill form</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <xpath expr="//button[@name='action_post'][2]" position="attributes">
            <attribute name="groups" />
            <attribute
                    name="attrs"
                >{'invisible': [('confirm_ok', '!=', True)]}</attribute>
        </xpath>
        <xpath expr="//button[@name='button_draft']" position="attributes">
            <attribute name="groups" />
            <attribute
                    name="attrs"
                >{'invisible' : [('restart_ok', '!=', True)]}</attribute>
        </xpath>
        <xpath expr="//button[@name='button_cancel']" position="attributes">
            <attribute name="groups" />
            <attribute
                    name="attrs"
                >{'invisible' : [('cancel_ok', '!=', True)]}</attribute>
        </xpath>
        <xpath expr="//notebook" position="inside">
            <page name="policy" string="Policies" groups="base.group_system">
                <group name="policy_1" colspan="4" col="2">
                    <field name="policy_template_id" groups="base.group_system" />
                    <button
                            name="action_reload_policy_template"
                            type="object"
                            string="Reload Template Policy"
                            class="oe_highlight"
                            icon="fa-refresh"
                        />
                </group>
                <group name="policy_2" colspan="4" col="2">
                    <field name="confirm_ok" />
                    <field name="send_print_ok" />
                    <field name="register_payment_ok" />
                    <field name="preview_ok" />
                    <field name="add_credit_note_ok" />
                    <field name="post_ok" />
                    <field name="reverse_entry_ok" />
                    <field name="cancel_ok" />
                    <field name="restart_ok" />
                </group>
            </page>
        </xpath>
    </field>
</record>

<record id="vendor_bill_action" model="ir.actions.act_window">
    <field name="name">Vendor Bills</field>
    <field name="res_model">vendor_bill</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'default_move_type': 'in_invoice'}</field>
    <field name="view_id" ref="vendor_bill_view_tree" />
    <field name="search_view_id" ref="vendor_bill_view_search" />
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create a vendor bill
        </p><p>
            Vendor bills register purchase invoices received from suppliers.
        </p>
    </field>
</record>

<menuitem
        id="vendor_bill_menu"
        name="Vendor Bill"
        parent="ssi_financial_accounting.menu_account_payable"
        action="vendor_bill_action"
        groups="ssi_vendor_bill.vendor_bill_viewer_group"
        sequence="5"
    />
</odoo>
