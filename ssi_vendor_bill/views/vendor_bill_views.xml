<odoo>
<!-- Primary tree view rebound to vendor_bill -->
<record id="vendor_bill_view_tree" model="ir.ui.view">
    <field name="name">vendor_bill tree</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="account.view_in_invoice_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<!-- Primary search view rebound to vendor_bill -->
<record id="vendor_bill_view_search" model="ir.ui.view">
    <field name="name">vendor_bill search</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<!-- Primary form view rebound to vendor_bill.
     Core account.view_move_form has no dedicated bill form, it is reused
     for every move_type, distinguished by attrs on move_type. Because this
     is a *primary* rebind, it automatically inherits every non-primary
     view that targets account.view_move_form, including
     ssi_financial_accounting.account_move_view_form, which already adds
     the "Policies" page and already rewrites the action_post[2]/
     button_draft/button_cancel attrs to the confirm_ok/restart_ok/
     cancel_ok policy fields used here. Re-adding the same page/attrs in
     this record duplicated them on screen (two "Policies" tabs), see
     open-synergy/ssi-vendor-bill#17. The arch is intentionally left empty,
     same pattern as vendor_bill_view_tree/vendor_bill_view_search above:
     this record only exists so the model has its own form view id
     (ssi_vendor_bill_operating_unit.vendor_bill_view_form inherits it). -->
<record id="vendor_bill_view_form" model="ir.ui.view">
    <field name="name">vendor_bill form</field>
    <field name="model">vendor_bill</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="vendor_bill_action" model="ir.actions.act_window">
    <field name="name">Vendor Bills</field>
    <field name="res_model">vendor_bill</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'default_move_type': 'in_invoice'}</field>
    <field name="view_id" ref="vendor_bill_view_tree" />
    <field name="search_view_id" ref="vendor_bill_view_search" />
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create a vendor bill
        </p><p>
            Vendor bills register purchase invoices received from suppliers.
        </p>
    </field>
</record>

<menuitem
        id="vendor_bill_menu"
        name="Vendor Bill"
        parent="ssi_financial_accounting.menu_account_payable"
        action="vendor_bill_action"
        groups="ssi_vendor_bill.vendor_bill_viewer_group"
        sequence="5"
    />
</odoo>
