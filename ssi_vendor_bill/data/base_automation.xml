<odoo>
<record id="vendor_bill_open_2_done" model="base.automation">
    <field name="action_server_id" ref="vendor_bill_action_done" />
    <field name="trigger">on_write</field>
    <field name="filter_pre_domain">[('realized','=',False)]</field>
    <field name="filter_domain">[('realized','=',True)]</field>
</record>

